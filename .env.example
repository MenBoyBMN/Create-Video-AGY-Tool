# Gemini Native TTS (Free Tier at Google AI Studio — expressive voiceStyle & Multi-Speaker)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Free Stock B-Roll & Editorial Images (optional — used by `cli media`)
PEXELS_API_KEY=
