{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@agy/motion": ["engine/motion/index.ts"],
      "@agy/presets": ["engine/presets/index.ts"],
      "@agy/runtime": ["engine/runtime/index.ts"],
      "@app/*": ["app/src/*"]
    }
  },
  "include": [
    "app/src",
    "engine/motion",
    "engine/presets",
    "engine/runtime",
    "tests"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "release", "projects"]
}
