{
  "name": "agy-video-studio",
  "version": "2.0.0",
  "description": "AGY Video Studio — Portable 60fps Motion Graphics Desktop App & CLI Bridge for AGY Studio",
  "main": "dist-electron/main.cjs",
  "author": "AGY Studio",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:electron",
    "build:portable": "npm run build && electron-builder --win dir --config electron-builder.yml && node scripts/finalize-portable.mjs",
    "install:skill": "node scripts/install-skill.mjs",
    "check:release": "node scripts/security-check.mjs",
    "setup": "powershell -ExecutionPolicy Bypass -File setup.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "cli": "node cli/agy-studio.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@remotion/bundler": "4.0.545",
    "@remotion/lottie": "^4.0.545",
    "@remotion/motion-blur": "^4.0.545",
    "@remotion/noise": "^4.0.545",
    "@remotion/paths": "^4.0.545",
    "@remotion/player": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "@remotion/shapes": "^4.0.545",
    "@remotion/three": "^4.0.545",
    "@remotion/transitions": "^4.0.545",
    "esbuild": "^0.28.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "remotion": "4.0.545",
    "roughjs": "^4.6.6",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
